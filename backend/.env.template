# ── REQUIRED ──────────────────────────────────────────────────
GROQ_API_KEY=your_key_here

# ── JOB SEARCH (Free tier: 250 req/day) ───────────────────────
# Get at: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# ── RICHER JOB SEARCH (Optional, paid) ────────────────────────
# Google Jobs via SerpAPI: https://serpapi.com
SERPAPI_KEY=

# ── AUTO-APPLY (Playwright) ────────────────────────────────────
# Set to true to enable automated form submission
# Supports: LinkedIn Easy Apply, Greenhouse, Lever
AUTO_APPLY_ENABLED=false

# ── JOB SEARCH CONFIG ─────────────────────────────────────────
# Comma-separated ISO country codes
JOB_SEARCH_COUNTRIES=["eg","gb","us","ae"]
JOB_SEARCH_KEYWORDS=["machine learning engineer","AI engineer","deep learning engineer","computer vision engineer","NLP engineer"]

# ── DATABASE ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./career_copilot.db
